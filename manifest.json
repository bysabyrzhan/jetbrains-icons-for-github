{
  "manifest_version": 3,
  "name": "JetBrains Icons for GitHub",
  "version": "0.1.0",
  "description": "Adds file and folder icons to GitHub.",
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["icon-sets.js", "content.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/json/json-light.svg",
        "icons/json/json-dark.svg",
        "icons/markdown/markdown-light.svg",
        "icons/markdown/markdown-dark.svg",
        "icons/html/html-light.svg",
        "icons/html/html-dark.svg",
        "icons/css/css-light.svg",
        "icons/css/css-dark.svg",
        "icons/javascript/javascript-light.svg",
        "icons/javascript/javascript-dark.svg",
        "icons/typescript/typescript-light.svg",
        "icons/typescript/typescript-dark.svg",
        "icons/jsx/jsx-light.svg",
        "icons/jsx/jsx-dark.svg",
        "icons/tsx/tsx-light.svg",
        "icons/tsx/tsx-dark.svg",
        "icons/text/text-light.svg",
        "icons/text/text-dark.svg",
        "icons/ignored/ignored-light.svg",
        "icons/ignored/ignored-dark.svg",
        "icons/editorconfig/editorconfig-light.svg",
        "icons/editorconfig/editorconfig-dark.svg",
        "icons/image/image-light.svg",
        "icons/image/image-dark.svg",
        "icons/folder/folder-light.svg",
        "icons/folder/folder-dark.svg",
        "icons/unknown/unknown-light.svg",
        "icons/unknown/unknown-dark.svg"
      ],
      "matches": ["https://github.com/*"]
    }
  ]
}

{
  "manifest_version": 3,
  "name": "JetBrains Icons for GitHub",
  "version": "0.1.0",
  "description": "Adds file and folder icons to GitHub.",
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/json/json.svg",
        "icons/json/json_dark.svg",
        "icons/markdown/markdown.svg",
        "icons/markdown/markdown_dark.svg",
        "icons/html/html.svg",
        "icons/html/html_dark.svg",
        "icons/css/css.svg",
        "icons/css/css_dark.svg",
        "icons/javaScript/javaScript.svg",
        "icons/javaScript/javaScript_dark.svg",
        "icons/typeScript/typeScript.svg",
        "icons/typeScript/typeScript_dark.svg",
        "icons/jsx/jsx.svg",
        "icons/jsx/jsx_dark.svg",
        "icons/tsx/tsx.svg",
        "icons/tsx/tsx_dark.svg",
        "icons/gitignore/gitignore.svg",
        "icons/editorConfig/editorConfig.svg",
        "icons/editorConfig/editorConfig_dark.svg"
      ],
      "matches": ["https://github.com/*"]
    }
  ]
}
